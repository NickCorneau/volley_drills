.worktrees/
# Historical local artifacts from the retired queued-task control plane.
ops/agent/state/
ops/agent/runs/*
.cursor/hooks/state/
.cursor/plans/
.cursor/state/
.compound-engineering/*.local.yaml

# Local environment files. Commit only checked-in examples.
.env
.env.*
!.env.example
app/.env
app/.env.*
!app/.env.example

# Claude Code local tooling: machine-specific absolute paths (launch.json)
# and local permission grants (settings.local.json). Not portable; never commit.
.claude/settings.local.json
.claude/launch.json

# Local debug screenshots captured at the repo ROOT by preview / Playwright
# runs (home.png, safety-*.png, run-segment-*.png, setup*.png, settings.png...).
# App icons live under app/public/ and stay tracked; this only ignores root.
/*.png
